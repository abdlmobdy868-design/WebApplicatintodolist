@model List<TodoItem>
@{
    ViewData["Title"] = "TodoItem List";
}

<h2>TodoItem List</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add New Task</a>

<form asp-action="Index" method="get" class="mb-3 d-flex">
    <input name="searchString" class="form-control me-2" placeholder="Search..." />
    <button type="submit" class="btn btn-info">Search</button>
</form>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Deadline</th>
            <th>File</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.Deadline.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (item.FilePath != null)
                    {
                        <a asp-action="Download" asp-route-fileName="@item.FilePath" class="btn btn-success btn-sm">Download</a>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <button type="button" onclick="confirmDelete(@item.Id)" class="btn btn-danger btn-sm">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.createElement("form");
                    form.method = "post";
                    form.action = "/TodoItem/Delete/" + id;
                    var token = document.querySelector('#antiForgeryForm input').value;
                    form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}">`;
                    document.body.appendChild(form);
                    form.submit();
                }
            })
        }
    </script>
}
